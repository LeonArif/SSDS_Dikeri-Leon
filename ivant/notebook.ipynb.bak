     ]
    }
   ],
   "source": [
    "X_train_noPos = X_train.drop(columns=['nama_pos'], errors='ignore')\n",
    "X_val_noPos = X_val.drop(columns=['nama_pos'], errors='ignore')\n",
    "\n",
    "model_xgb_noPos = XGBRegressor(\n",
    "    n_estimators=1500, learning_rate=LR, random_state=42,\n",
    "    objective='reg:squarederror', tree_method='hist',\n",
    "    enable_categorical=True, early_stopping_rounds=50,\n",
    ")\n",
    "model_xgb_noPos.fit(X_train_noPos, y_train, eval_set=[(X_val_noPos, y_val)], verbose=False)\n",
    "\n",
    "pred_xgb_noPos_train = model_xgb_noPos.predict(X_train_noPos)\n",
    "pred_xgb_noPos_val = model_xgb_noPos.predict(X_val_noPos)\n",
    "rmse_xgb_noPos_train = math.sqrt(mean_squared_error(y_train, pred_xgb_noPos_train))\n",
    "rmse_xgb_noPos = math.sqrt(mean_squared_error(y_val, pred_xgb_noPos_val))\n",
    "print(f'RMSE XGBoost tanpa nama_pos: {rmse_xgb_noPos:.4f} (sebelumnya: {rmse_xgb:.4f})')\n",
    "\n",
    "rmse_recursive_xgb_noPos, _ = recursive_walk_forward_validation(\n",
    "    model=model_xgb_noPos, train_ref_df=train_full_sorted, val_df=val_data, env_df=env_df,\n",
    "    hist_mean_map=hist_mean_map,\n",
    "    all_cats_ref_local={c: pd.Categorical(X_train[c]).categories for c in cat_cols if c != 'nama_pos'},\n",
    "    cat_cols_local=[c for c in cat_cols if c != 'nama_pos'],\n",
    "    final_col_order_local=X_train_noPos.columns.tolist(),\n",
    "    lag_steps=LAG_STEPS, roll_windows=ROLL_WINDOWS,\n",
    ")\n",
    "print(f'RMSE recursive XGBoost tanpa nama_pos: {rmse_recursive_xgb_noPos:.4f}')"
   ]
  },
