   "source": [
    "model_key_map = {\n",
    "    'lgbm': 'LightGBM',\n",
    "    'lgbm_resid': 'LightGBM Residual',\n",
    "    'xgb': 'XGBoost',\n",
    "    'xgb_resid': 'XGBoost Residual',\n",
    "    'cat': 'CatBoost',\n",
